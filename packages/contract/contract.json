{
  "rpc": {
    "getLearningFeedbackCatalog": {
      "client": "both",
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {}
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "catalogVersion": {
            "type": "string"
          },
          "catalog": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "title"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "catalogVersion",
          "catalog"
        ],
        "additionalProperties": false
      }
    },
    "getLearningHookContext": {
      "client": "hook",
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6000
          },
          "sessionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "requestId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "foundationFirst": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "message",
          "sessionId",
          "requestId"
        ]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "influence",
              "no_context",
              "fail_open"
            ]
          },
          "context": {
            "type": "string",
            "maxLength": 4000
          },
          "conceptIds": {
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "datasetTag": {
            "type": "string",
            "const": "dev1"
          },
          "experimentId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              {
                "type": "null"
              }
            ]
          },
          "foundationFirst": {
            "type": "boolean"
          },
          "policyRevision": {
            "type": "string",
            "enum": [
              "foundation-first-v1",
              "task-teaching-v2"
            ]
          },
          "durationMs": {
            "type": "number"
          },
          "requestId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "decision",
          "context",
          "conceptIds",
          "datasetTag",
          "experimentId",
          "foundationFirst",
          "policyRevision",
          "durationMs",
          "requestId"
        ],
        "additionalProperties": false
      }
    },
    "beginLearningFeedbackTurn": {
      "client": "hook",
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string"
          },
          "turnId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "message": {
            "type": "string"
          },
          "foundationFirst": {
            "type": "boolean"
          },
          "catalogVersion": {
            "type": "string"
          }
        },
        "required": [
          "sessionId",
          "turnId",
          "message"
        ]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "turnId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "catalogVersion": {
            "type": "string"
          },
          "catalog": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "title"
                  ],
                  "additionalProperties": false
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "instructions": {
            "type": "string"
          },
          "recentFeedback": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "turnId": {
                  "type": "string"
                },
                "matches": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "conceptId": {
                        "type": "string"
                      },
                      "outcome": {
                        "type": "string"
                      },
                      "remainingGap": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "conceptId",
                      "outcome"
                    ],
                    "additionalProperties": false
                  }
                },
                "taughtConceptIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "turnId",
                "matches",
                "taughtConceptIds"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "turnId",
          "catalogVersion",
          "catalog",
          "instructions",
          "recentFeedback"
        ],
        "additionalProperties": false
      }
    },
    "submitLearningTurnFeedback": {
      "client": "hook",
      "input": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string"
          },
          "turnId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "catalogVersion": {
            "type": "string"
          },
          "matches": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "conceptId": {
                  "type": "string"
                },
                "quote": {
                  "type": "string"
                },
                "relationship": {
                  "type": "string",
                  "enum": [
                    "mention",
                    "task_context",
                    "learner_evidence",
                    "misconception"
                  ]
                },
                "outcome": {
                  "type": "string",
                  "enum": [
                    "demonstrated",
                    "partial",
                    "unclear",
                    "not_assessed"
                  ]
                },
                "reason": {
                  "type": "string"
                },
                "remainingGap": {
                  "type": "string"
                }
              },
              "required": [
                "conceptId",
                "quote",
                "relationship",
                "outcome",
                "reason"
              ]
            }
          },
          "taughtConceptIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "sessionId",
          "turnId",
          "catalogVersion",
          "matches"
        ]
      },
      "output": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "provisional"
          },
          "replayed": {
            "type": "boolean"
          },
          "guidance": {
            "type": "object",
            "properties": {
              "decision": {
                "type": "string",
                "enum": [
                  "influence",
                  "no_context",
                  "fail_open"
                ]
              },
              "context": {
                "type": "string",
                "maxLength": 4000
              },
              "conceptIds": {
                "maxItems": 5,
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "datasetTag": {
                "type": "string",
                "const": "dev1"
              },
              "experimentId": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "foundationFirst": {
                "type": "boolean"
              },
              "policyRevision": {
                "type": "string",
                "enum": [
                  "foundation-first-v1",
                  "task-teaching-v2"
                ]
              },
              "durationMs": {
                "type": "number"
              },
              "requestId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              }
            },
            "required": [
              "decision",
              "context",
              "conceptIds",
              "datasetTag",
              "experimentId",
              "foundationFirst",
              "policyRevision",
              "durationMs",
              "requestId"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "status",
          "replayed",
          "guidance"
        ],
        "additionalProperties": false
      }
    },
    "recordLearningFeedbackTrace": {
