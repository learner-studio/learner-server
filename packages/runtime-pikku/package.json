{
  "name": "@learner/runtime-pikku",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#pikku/*.js": "./.pikku/*.ts",
    "#pikku/*": "./.pikku/*/index.ts"
  },
  "exports": {
    "./*": "./src/*"
  },
  "dependencies": {
    "@better-auth/api-key": "1.6.19",
    "@pikku/better-auth": "0.12.36",
    "@pikku/bun-server": "0.12.11",
    "@pikku/core": "0.12.102",
    "@pikku/kysely": "0.13.22",
    "@pikku/queue-pg-boss": "0.12.10",
    "@pikku/schema-cfworker": "0.12.6",
    "better-auth": "1.6.19",
    "kysely": "0.29.5",
    "pg": "8.23.0",
    "pg-boss": "12.29.0",
    "zod": "4.5.4",
    "@learner/core": "workspace:*",
    "@learner/server": "workspace:*"
  },
  "devDependencies": {
    "@pikku/cli": "0.12.122",
    "@pikku/inspector": "0.12.65"
  },
  "scripts": {
    "prepare": "bun scripts/generate.ts",
    "generate": "bun scripts/generate.ts --force",
    "dev": "bun --watch src/bin/api.ts",
    "api": "bun src/bin/api.ts",
    "worker": "bun src/bin/worker.ts",
    "worker-dev": "bun --watch src/bin/worker.ts"
  }
}
