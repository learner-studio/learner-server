{
  "name": "@learner/runtime-pikku",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#pikku/*.js": "./.pikku/*.ts",
    "#pikku/*": "./.pikku/*/index.ts"
  },
  "exports": {
    "./pikku/*.js": "./.pikku/*.ts",
    "./pikku/*": "./.pikku/*/index.ts",
    "./*": "./src/*"
  },
  "dependencies": {
    "@better-auth/api-key": "1.6.19",
    "@pikku/better-auth": "0.12.64",
    "@pikku/bun-server": "0.12.17",
    "@pikku/core": "0.12.156",
    "@pikku/kysely": "0.13.43",
    "@pikku/queue-pg-boss": "0.12.14",
    "@pikku/schema-cfworker": "0.12.9",
    "better-auth": "1.6.19",
    "kysely": "0.29.9",
    "pg": "8.23.0",
    "pg-boss": "12.38.2",
    "zod": "4.5.4",
    "@learner/core": "workspace:*",
    "@learner/server": "workspace:*",
    "@pikku/kysely-postgres": "0.12.30"
  },
  "devDependencies": {
    "@pikku/cli": "0.12.210",
    "@pikku/inspector": "0.12.119"
  },
  "scripts": {
    "prepare": "bun scripts/generate.ts",
    "migrate": "bun ../server/src/db/migrate.ts",
    "generate": "bun scripts/generate.ts --force",
    "api": "bun src/bin/api.ts",
    "worker": "bun src/bin/worker.ts"
  }
}
