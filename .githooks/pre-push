#!/usr/bin/env bash
# pre-push: typecheck + the full test suite, side by side. Target: under a minute
# (measured 2026-10-27: typecheck 15s + suite 44s run alone; 33s side by side).
#
# The same two checks CI runs, on the same kind of database (fresh, postgres:17, en_US.utf8),
# so a push that passes here should pass there.
# The difference: this reads your working tree, including uncommitted edits
# (yours or a peer's in a shared checkout); CI reads the pushed commit on a
# clean machine. CI is the one that decides.
#
# Not here: `bun run gate` (boots the API + worker, needs /etc/learner/*.env).
#
# Skip once: git push --no-verify       Details: docs/checks.md
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

if [ -r /etc/learner/db.env ]; then set -- --env-file=/etc/learner/db.env; else set --; fi

log_dir=$(mktemp -d)
trap 'rm -rf "$log_dir"' EXIT

# Both checks read the generated .pikku/ output, which git does not carry: a rebase that changes a workflow body
# leaves it stale, and the checks then judge the new code against the old meta. Regenerate it first, the way the
# units do (runtime.ts prepare: under the prepare lock, skipped when fresh) and `bun install` does in CI.
# The generated wiring IS tracked, and prepare rewrites it: check it first, or a stale commit is repaired, not caught.
echo "[pre-push] codegen"
if ! (cd packages/runtime-pikku && bun scripts/gen-wiring.ts --check) > "$log_dir/prepare" 2>&1 ||
   ! bun scripts/runtime.ts prepare > "$log_dir/prepare" 2>&1; then cat "$log_dir/prepare"; echo "[pre-push] ✗ codegen failed" >&2; exit 1; fi
echo "[pre-push] typecheck + tests in parallel"
bun scripts/typecheck.ts > "$log_dir/typecheck" 2>&1 & tc=$!
# Tests run on a fresh database in CI's own Postgres image and locale (scripts/test-clean-db.ts):
# the shared C.UTF-8 learner_test let two classes of CI failure through (docs/checks.md).
# Without Docker, exit 3: fall back to learner_test and say so.
(
  bun scripts/test-clean-db.ts; rc=$?
  if [ $rc -eq 3 ]; then echo "[pre-push] no Docker: tests on learner_test, NOT a CI-identical database"; bun "$@" scripts/run-tests.ts; rc=$?; fi
  exit $rc
) > "$log_dir/test" 2>&1 & ts=$!
wait $tc; tc_rc=$?
wait $ts; ts_rc=$?

if [ $tc_rc -ne 0 ]; then cat "$log_dir/typecheck"; echo "[pre-push] ✗ typecheck failed" >&2; fi
if [ $ts_rc -ne 0 ]; then cat "$log_dir/test"; echo "[pre-push] ✗ tests failed" >&2; fi
if [ $tc_rc -ne 0 ] || [ $ts_rc -ne 0 ]; then exit 1; fi
tail -1 "$log_dir/test"
echo "[pre-push] ✓ typecheck + tests green"
