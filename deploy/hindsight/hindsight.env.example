# Archive-only Hindsight 0.9.2 configuration. The live copy is
# /etc/learner/hindsight.env (root-only; systemd reads it as root).
HINDSIGHT_API_DATABASE_BACKEND=postgresql
HINDSIGHT_API_DATABASE_URL=postgresql://hindsight@/hindsight?host=/var/run/postgresql
HINDSIGHT_API_DATABASE_SCHEMA=public
HINDSIGHT_API_VECTOR_EXTENSION=pgvector
HINDSIGHT_API_TEXT_SEARCH_EXTENSION=native
HINDSIGHT_API_DB_POOL_MIN_SIZE=1
HINDSIGHT_API_DB_POOL_MAX_SIZE=4

# No-token invariant. Keep every operation-specific provider disabled too;
# these otherwise take precedence over the global provider.
HINDSIGHT_API_LLM_PROVIDER=none
HINDSIGHT_API_RETAIN_LLM_PROVIDER=none
HINDSIGHT_API_REFLECT_LLM_PROVIDER=none
HINDSIGHT_API_CONSOLIDATION_LLM_PROVIDER=none
HINDSIGHT_API_RETAIN_EXTRACTION_MODE=chunks
HINDSIGHT_API_ENABLE_OBSERVATIONS=false
HINDSIGHT_API_ENABLE_AUTO_CONSOLIDATION=false
HINDSIGHT_API_STORE_DOCUMENT_TEXT=true
HINDSIGHT_API_ENABLE_BANK_CONFIG_API=false

# Local-only vector generation. Offline flags prevent model-registry fallback.
HINDSIGHT_API_EMBEDDINGS_PROVIDER=local
HINDSIGHT_API_EMBEDDINGS_LOCAL_MODEL=BAAI/bge-small-en-v1.5
HINDSIGHT_API_EMBEDDINGS_LOCAL_FORCE_CPU=true
HINDSIGHT_API_EMBEDDINGS_LOCAL_TRUST_REMOTE_CODE=false
# `none` is not a valid 0.9.2 reranker. RRF is local and model-free.
HINDSIGHT_API_RERANKER_PROVIDER=rrf
HF_HOME=/var/lib/biztools-hindsight/cache/huggingface
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
XDG_CACHE_HOME=/var/lib/biztools-hindsight/cache
TORCH_HOME=/var/lib/biztools-hindsight/cache/torch

HINDSIGHT_API_RUN_MIGRATIONS_ON_STARTUP=true
HINDSIGHT_API_LOG_LEVEL=info
