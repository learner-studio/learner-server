{
  "name": "learner",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*",
    "apps/*",
    "clients/*"
  ],
  "scripts": {
    "typecheck": "bun scripts/typecheck.ts",
    "test": "bun --env-file=/etc/learner/db.env scripts/run-tests.ts",
    "test:python": "bash scripts/test-python.sh",
    "dev": "bun --env-file=/etc/learner/db.env --env-file=/etc/learner/learner.env scripts/runtime.ts dev",
    "dev:web": "bun run --filter @learner/web dev",
    "build:web": "bun run --filter @learner/web build",
    "build:web:proxied": "bun run --filter @learner/web build:proxied",
    "migrate": "bun packages/server/src/db/migrate.ts",
    "contract:json": "bun packages/contract/scripts/emit-json.ts",
    "start": "bun --env-file=/etc/learner/db.env --env-file=/etc/learner/learner.env scripts/runtime.ts api",
    "worker": "bun --env-file=/etc/learner/db.env --env-file=/etc/learner/learner.env scripts/runtime.ts worker",
    "deploy": "bun scripts/deploy.ts",
    "prepare:runtime": "bun scripts/runtime.ts prepare",
    "gate": "bun --env-file=/etc/learner/db.env --env-file=/etc/learner/learner.env scripts/gate.ts",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/pg": "8.23.1",
    "kysely-codegen": "^0.20.0",
    "pg": "8.23.0",
    "playwright": "1.62.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@ai-sdk/provider": "4.0.10",
    "@ai-sdk/provider-utils": "5.0.36",
    "@pikku/addon-console": "0.12.69",
    "@pikku/ai-vercel": "0.12.16",
    "@pikku/better-auth": "0.12.64",
    "@pikku/bun-server": "0.12.17",
    "@pikku/cli": "0.12.210",
    "@pikku/code-edit": "0.12.13",
    "@pikku/core": "0.12.156",
    "@pikku/deploy": "0.12.21",
    "@pikku/deploy-cloudflare": "0.12.24",
    "@pikku/fetch": "0.12.16",
    "@pikku/inspector": "0.12.119",
    "@pikku/jose": "0.12.10",
    "@pikku/knowledge": "0.12.22",
    "@pikku/kysely": "0.13.43",
    "@pikku/modelcontextprotocol": "0.12.19",
    "@pikku/node-http-server": "0.12.22",
    "@pikku/openapi-parser": "0.12.26",
    "@pikku/openapi-to-zod-schema": "0.12.8",
    "@pikku/queue-pg-boss": "0.12.14",
    "@pikku/schedule": "0.12.13",
    "@pikku/schema-cfworker": "0.12.9",
    "@pikku/skills": "0.12.74",
    "@electric-sql/pglite": "0.5.5",
    "@pikku/kysely-postgres": "0.12.30"
  },
  "version": "0.1.0"
}
