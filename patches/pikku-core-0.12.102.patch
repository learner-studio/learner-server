+/** Bun's `createRequire` honours the referrer it is given in a short-lived
+ *  script, but not inside the long-lived `pikku dev` process: there, relative
+ *  and `#imports` specifiers resolve from somewhere other than the importing
+ *  file, so a hot reload of any file using them fails forever with
+ *  `Cannot find module` while the same file imports fine at startup.
+ *  Resolving each specifier against the importer's own directory first, and
+ *  handing `require` the absolute path that comes back, makes reload
+ *  resolution agree with what the file itself sees. A specifier Bun cannot
+ *  resolve (a builtin, or one that really is missing) is passed through
+ *  untouched so the original error still reaches the developer. Non-Bun
+ *  runtimes keep plain `createRequire` behaviour. */
+const createRequireForFile = (absPath) => {
+    const base = createRequire(pathToFileURL(absPath));
+    if (typeof Bun === 'undefined')
+        return base;
+    const baseDir = dirname(absPath);
+    const resolveFrom = (spec) => {
+        try {
+            return Bun.resolveSync(spec, baseDir);
+        }
+        catch {
+            return spec;
+        }
+    };
+    const patched = (spec) => base(resolveFrom(spec));
+    patched.resolve = (spec) => {
+        const resolved = resolveFrom(spec);
+        return resolved === spec ? base.resolve(spec) : resolved;
+    };
+    patched.resolve.paths = (spec) => base.resolve.paths?.(spec) ?? null;
+    patched.cache = base.cache;
+    patched.extensions = base.extensions;
+    patched.main = base.main;
+    return patched;
+};
